{
  "name": "twenty-one-standalone",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview --host 0.0.0.0",
    "build:portable": "npm run build && node scripts/portable.mjs",
    "benchmark": "node --import tsx scripts/solver-benchmark.ts",
    "predev": "node scripts/build-coach-worker.mjs",
    "prebuild": "node scripts/build-coach-worker.mjs",
    "pretest": "node scripts/build-coach-worker.mjs",
    "test:portable": "node scripts/portable-smoke.cjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "esbuild": "0.25.12",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.1.9",
    "vitest": "3.2.4"
  }
}
