{
  "name": "sleeping-mecha-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "predev": "CONTENT_PREVIEW=1 node scripts/compile-content.mjs",
    "prebuild": "node scripts/compile-content.mjs && node --experimental-strip-types scripts/validate-world.ts",
    "build:preview": "CONTENT_PREVIEW=1 npm run build",
    "build:node": "CONTENT_PREVIEW=0 DEPLOY_TARGET=node npm run build",
    "start:node": "HOST=127.0.0.1 node dist/standalone/server.js",
    "precheck": "node scripts/compile-content.mjs",
    "check": "tsc --noEmit && node --experimental-strip-types scripts/validate-world.ts && node scripts/check-content.mjs && node --experimental-strip-types scripts/check-world.ts && node --experimental-strip-types scripts/check-workbench.ts",
    "maps": "node --experimental-strip-types scripts/generate-maps.ts",
    "example:forest": "npm --prefix examples/forest-courtyard run dev",
    "check:forest": "npm --prefix examples/forest-courtyard run check",
    "build:forest": "npm --prefix examples/forest-courtyard run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "gray-matter": "4.0.3",
    "input-otp": "1.4.2",
    "katex": "0.16.22",
    "lucide-react": "1.31.0",
    "marked": "17.0.1",
    "phaser": "4.2.1",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "19.2.6",
    "recharts": "3.8.0",
    "sanitize-html": "2.17.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.0.0-beta.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
